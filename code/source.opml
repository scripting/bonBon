				</outline>
			<outline text=":root[data-theme=&quot;dark&quot;] {">
				<outline text="--bg: #15160f; --fg: #d7d7c9; --muted: #8a8b80; --rule: #30312a;"/>
				<outline text="--link: #6fd0a8; --link-visited: #c0a9e8; --accent: #f08a4b; color-scheme: dark;">
					<outline text="--tint-code: rgba(215, 215, 201, 0.08); --tint-pre: rgba(215, 215, 201, 0.04);"/>
					</outline>
				<outline text="}"/>
				</outline>
			<outline text=""/>
			<outline text="body {">
				<outline text="margin: 0;"/>
				<outline text="background: var(--bg);"/>
				<outline text="color: var(--fg);"/>
				<outline text="font-family: var(--font-body);"/>
				<outline text="font-size: 15px;"/>
				<outline text="line-height: 1.65;"/>
				<outline text="}"/>
				</outline>
			<outline text=".page {">
				<outline text="max-width: 38rem;"/>
				<outline text="margin: 0 auto;"/>
				<outline text="padding-block: 2.5rem 5rem;"/>
				<outline text="padding-left: max(16px, env(safe-area-inset-left, 0px));"/>
				<outline text="padding-right: max(16px, env(safe-area-inset-right, 0px));"/>
				<outline text="}"/>
				</outline>
			<outline text=""/>
			<outline text="h1 {">
				<outline text="font-weight: 600;"/>
				<outline text="font-size: 1.5rem;"/>
				<outline text="line-height: 1.3;"/>
				<outline text="margin: 0 0 2rem;"/>
				<outline text="padding-bottom: 0.75rem;"/>
				<outline text="border-bottom: 1px solid var(--fg);"/>
				<outline text="}"/>
				</outline>
			<outline text="h1::before { content: &quot;# &quot;; color: var(--muted); }"/>
			<outline text="h2 {">
				<outline text="font-weight: 600;"/>
				<outline text="font-size: 1rem;"/>
				<outline text="color: var(--fg);"/>
				<outline text="margin: 3rem 0 1rem;"/>
				<outline text="clear: both;"/>
				<outline text="}"/>
				</outline>
			<outline text="h2::before { content: &quot;## &quot;; color: var(--muted); }"/>
			<outline text="h3 {">
				<outline text="font-weight: 600;"/>
				<outline text="font-size: 1rem;"/>
				<outline text="margin: 2rem 0 0.75rem;"/>
				<outline text="clear: both;"/>
				<outline text="}"/>
				</outline>
			<outline text="h3::before { content: &quot;### &quot;; color: var(--muted); }"/>
			<outline text="h2 a, h3 a { color: inherit; text-decoration: none; }"/>
			<outline text="h2 a:hover, h3 a:hover { color: var(--accent); }"/>
			<outline text=""/>
			<outline text="p { margin: 0 0 1.25rem; }"/>
			<outline text="a { color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }"/>
			<outline text="a:visited { color: var(--link-visited); }"/>
			<outline text="a:hover { color: var(--accent); }"/>
			<outline text="strong { font-weight: 600; }"/>
			<outline text="em { font-style: italic; }"/>
			<outline text=""/>
