		<outline text="stylesheets/mono.css">
			<outline text="/* Mono — plain text, as a programmer reads it. One monospace face, narrow measure, headings marked the way Markdown marks them. */"/>
			<outline text=""/>
			<outline text="@import url(&quot;fonts/ibm-plex-mono.css&quot;); /* 10/27/26 by CC -- the font ships with the app, in the fonts folder beside this file, so the page is the same offline and Google never hears from it */"/>
			<outline text=""/>
			<outline text=":root {">
				<outline text="--bg: #fbfbf8;"/>
				<outline text="--fg: #23241f;"/>
