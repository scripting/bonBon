				<outline text="color: var(--muted);"/>
				<outline text="text-decoration: none;"/>
				<outline text="}"/>
				</outline>
			<outline text="a[title=&quot;Direct link to this item.&quot;]:hover { color: var(--accent); }"/>
			<outline text=""/>
			<outline text="img {">
				<outline text="max-width: 100%;"/>
				<outline text="height: auto;"/>
				<outline text="border: 1px solid var(--rule);"/>
				<outline text="}"/>
				</outline>
			<outline text="p &gt; img:first-child {">
				<outline text="float: right;"/>
				<outline text="max-width: 36%;"/>
				<outline text="margin: 0.25rem 0 0.75rem 1.25rem;"/>
				<outline text="}"/>
				</outline>
			<outline text="p &gt; img:only-child {">
				<outline text="float: none;"/>
				<outline text="display: block;"/>
				<outline text="max-width: 100%;"/>
