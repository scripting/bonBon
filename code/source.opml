				<outline text="}"/>
				</outline>
			<outline text=""/>
			<outline text="ul, ol { padding-left: 1.75rem; margin: 0 0 1.25rem; }"/>
			<outline text="ul { list-style: none; padding-left: 1.5rem; }"/>
			<outline text="ul &gt; li::before { content: &quot;- &quot;; color: var(--muted); margin-left: -1.5rem; display: inline-block; width: 1.5rem; }"/>
			<outline text="li { margin-bottom: 0.35rem; }"/>
			<outline text="li &gt; p { margin-bottom: 0.5rem; display: inline; }"/>
			<outline text=""/>
			<outline text="blockquote {">
				<outline text="margin: 1.5rem 0;"/>
				<outline text="padding: 0 0 0 1.25rem;"/>
