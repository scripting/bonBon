				<outline text="--font-body: &quot;IBM Plex Mono&quot;, ui-monospace, Menlo, Consolas, monospace;"/>
				<outline text="--font-head: var(--font-body);"/>
				<outline text="--font-code: var(--font-body);"/>
				<outline text="--tint-code: rgba(35, 36, 31, 0.08); /* 10/27/26 by CC -- the shaded backgrounds; they were color-mix (), which BonBon&apos;s Chromium (108) doesn&apos;t have */"/>
				<outline text="--tint-pre: rgba(35, 36, 31, 0.04);"/>
