			<outline text="pre { font-size: 0.9rem; line-height: 1.5; overflow-x: auto; padding: 1rem; border: 1px solid var(--rule); background: var(--tint-pre); }"/>
			<outline text="pre code { background: none; padding: 0; }"/>
			<outline text="table { border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: 0.95em; }"/>
			<outline text="th, td { text-align: left; padding: 0.4rem 0.6rem; border: 1px solid var(--rule); vertical-align: top; }"/>
			<outline text="th { font-weight: 600; }"/>
			</outline>
		<outline text="stylesheets/book.css">
			<outline text="/* Book — long-form reading. Large old-style serif, generous leading, a narrow centered column, dates set as centered running heads, images set as plates. */"/>
			<outline text=""/>
			<outline text="@import url(&quot;fonts/eb-garamond.css&quot;); /* 10/27/26 by CC -- the font ships with the app, in the fonts folder beside this file, so the page is the same offline and Google never hears from it */"/>
			<outline text=""/>
			<outline text=":root {">
				<outline text="--bg: #fdfcf9;"/>
				<outline text="--fg: #2a2520;"/>
				<outline text="--muted: #857b6e;"/>
				<outline text="--rule: #e3ddd1;"/>
				<outline text="--link: #3b4f8a;"/>
				<outline text="--link-visited: #6b4e80;"/>
				<outline text="--accent: #8b3a2f;"/>
				<outline text="--font-body: &quot;EB Garamond&quot;, Garamond, &quot;Hoefler Text&quot;, Georgia, serif;"/>
				<outline text="--font-head: var(--font-body);"/>
				<outline text="--font-code: ui-monospace, Menlo, Consolas, monospace;"/>
				<outline text="--tint-code: rgba(42, 37, 32, 0.06); /* 10/27/26 by CC -- the shaded backgrounds and the faded underline; they were color-mix (), which BonBon&apos;s Chromium (108) doesn&apos;t have */"/>
				<outline text="--tint-pre: rgba(42, 37, 32, 0.05);"/>
				<outline text="--link-underline: rgba(59, 79, 138, 0.5);"/>
				<outline text="}"/>
				</outline>
			<outline text="@media (prefers-color-scheme: dark) {">
				<outline text=":root:not([data-theme=&quot;light&quot;]) {">
					<outline text="--bg: #1d1a17; --fg: #e9e2d6; --muted: #a0958a; --rule: #3d3731;"/>
					<outline text="--link: #a9b8ea; --link-visited: #c9b0e0; --accent: #e08a7a; color-scheme: dark;"/>
					<outline text="--tint-code: rgba(233, 226, 214, 0.06); --tint-pre: rgba(233, 226, 214, 0.05); --link-underline: rgba(169, 184, 234, 0.5);"/>
					<outline text="}"/>
					</outline>
				<outline text="}"/>
				</outline>
			<outline text=":root[data-theme=&quot;dark&quot;] {">
				<outline text="--bg: #1d1a17; --fg: #e9e2d6; --muted: #a0958a; --rule: #3d3731;"/>
				<outline text="--link: #a9b8ea; --link-visited: #c9b0e0; --accent: #e08a7a; color-scheme: dark;">
					<outline text="--tint-code: rgba(233, 226, 214, 0.06); --tint-pre: rgba(233, 226, 214, 0.05); --link-underline: rgba(169, 184, 234, 0.5);"/>
					</outline>
				<outline text="}"/>
				</outline>
			<outline text=""/>
			<outline text="body {">
				<outline text="margin: 0;"/>
				<outline text="background: var(--bg);"/>
				<outline text="color: var(--fg);"/>
				<outline text="font-family: var(--font-body);"/>
				<outline text="font-size: 21px;"/>
				<outline text="line-height: 1.55;"/>
				<outline text="}"/>
				</outline>
			<outline text=".page {">
				<outline text="max-width: 36rem;"/>
				<outline text="margin: 0 auto;"/>
				<outline text="padding-block: 3.5rem 6rem;"/>
				<outline text="padding-left: max(16px, env(safe-area-inset-left, 0px));"/>
				<outline text="padding-right: max(16px, env(safe-area-inset-right, 0px));"/>
				<outline text="}"/>
				</outline>
			<outline text=""/>
			<outline text="h1 {">
				<outline text="font-weight: 500;"/>
				<outline text="font-size: 2.6rem;"/>
				<outline text="line-height: 1.1;"/>
				<outline text="letter-spacing: -0.01em;"/>
				<outline text="text-align: center;"/>
				<outline text="margin: 0 0 3rem;"/>
				<outline text="text-wrap: balance;"/>
				<outline text="}"/>
				</outline>
			<outline text="h2 {">
				<outline text="font-weight: 400;"/>
				<outline text="font-size: 0.85rem;"/>
				<outline text="letter-spacing: 0.18em;"/>
				<outline text="text-transform: uppercase;"/>
				<outline text="text-align: center;"/>
				<outline text="color: var(--muted);"/>
				<outline text="margin: 3.5rem 0 1.5rem;"/>
				<outline text="clear: both;"/>
				<outline text="}"/>
				</outline>
			<outline text="h2::before, h2::after { content: &quot;  ·  &quot;; color: var(--rule); }"/>
			<outline text="h3 {">
				<outline text="font-weight: 500;"/>
				<outline text="font-size: 1.6rem;"/>
				<outline text="line-height: 1.2;"/>
				<outline text="font-style: italic;"/>
				<outline text="margin: 2.5rem 0 1rem;"/>
				<outline text="text-wrap: balance;"/>
				<outline text="clear: both;"/>
				<outline text="}"/>
				</outline>
			<outline text="h2 a, h3 a { color: inherit; text-decoration: none; }"/>
			<outline text="h2 a:hover, h3 a:hover { color: var(--accent); }"/>
			<outline text=""/>
			<outline text="p { margin: 0 0 1.2rem; }"/>
			<outline text="a { color: var(--link); text-decoration: underline; text-decoration-thickness: 0.5px; text-underline-offset: 3px; text-decoration-color: var(--link-underline); }"/>
			<outline text="a:visited { color: var(--link-visited); }"/>
			<outline text="a:hover { color: var(--accent); text-decoration-color: currentColor; }"/>
			<outline text="strong { font-weight: 600; }"/>
			<outline text=""/>
			<outline text="a[title=&quot;Direct link to this item.&quot;] {">
				<outline text="color: var(--muted);"/>
				<outline text="text-decoration: none;"/>
				<outline text="font-size: 0.7em;"/>
				<outline text="vertical-align: 0.15em;"/>
				<outline text="padding-left: 0.35em;"/>
				<outline text="}"/>
				</outline>
			<outline text="a[title=&quot;Direct link to this item.&quot;]:hover { color: var(--accent); }"/>
			<outline text=""/>
			<outline text="img {">
				<outline text="max-width: 100%;"/>
				<outline text="height: auto;"/>
				<outline text="}"/>
				</outline>
			<outline text="p &gt; img:first-child {">
				<outline text="float: right;"/>
				<outline text="max-width: 38%;"/>
				<outline text="margin: 0.35rem 0 0.75rem 1.5rem;"/>
				<outline text="}"/>
				</outline>
			<outline text="p &gt; img:only-child {">
				<outline text="float: none;"/>
				<outline text="display: block;"/>
				<outline text="max-width: 100%;"/>
				<outline text="margin: 2rem auto;"/>
				<outline text="}"/>
				</outline>
			<outline text=""/>
			<outline text="ul, ol { padding-left: 1.6rem; margin: 0 0 1.2rem; }"/>
			<outline text="li { margin-bottom: 0.4rem; }"/>
			<outline text="li &gt; p { margin-bottom: 0.5rem; }"/>
			<outline text=""/>
			<outline text="blockquote {">
				<outline text="margin: 2rem 1.5rem;"/>
				<outline text="padding: 0;"/>
				<outline text="font-style: italic;"/>
				<outline text="color: var(--fg);"/>
				<outline text="text-align: center;"/>
				<outline text="}"/>
				</outline>
			<outline text="blockquote p:last-child { margin-bottom: 0; }"/>
			<outline text="hr { border: 0; text-align: center; margin: 3rem 0; color: var(--muted); }"/>
			<outline text="hr::after { content: &quot;❧&quot;; font-size: 1.4rem; }"/>
			<outline text=""/>
			<outline text="code { font-family: var(--font-code); font-size: 0.78em; background: var(--tint-code); padding: 0.1em 0.3em; border-radius: 3px; }"/>
			<outline text="pre { font-family: var(--font-code); font-size: 0.8rem; line-height: 1.5; overflow-x: auto; padding: 1rem; background: var(--tint-pre); border-radius: 4px; }"/>
			<outline text="pre code { background: none; padding: 0; }"/>
			<outline text="table { border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: 0.9em; }"/>
			<outline text="th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--rule); vertical-align: top; }"/>
			<outline text="th { font-weight: 500; font-variant: small-caps; letter-spacing: 0.05em; }"/>
			</outline>
		</body>
	</opml>
